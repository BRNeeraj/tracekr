SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=hackathon_user
DB_PASSWORD=change-this-password
DB_NAME=hackathon_tracker
# Optional alternative to the DB_* variables. Do not set both in production.
# DATABASE_URL=mysql+pymysql://hackathon_user:password@localhost:3306/hackathon_tracker
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-running
EVENT_NAME=Hackathon 2026
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Render supplies PORT automatically; leave this unset there.
# PORT=5000
FLASK_HTTPS=0
SSL_CERT_FILE=certs/dev-cert.pem
SSL_KEY_FILE=certs/dev-key.pem
